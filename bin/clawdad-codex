#!/usr/bin/env node
import {spawn} from 'node:child_process';
import path from 'node:path';
import fs from 'node:fs';

const [binary,separator,...args]=process.argv.slice(2);
try{
  if(separator!=='--')throw Error('Use the installed ClawDad Terminal launcher.');
  // Compatibility for already-open shells retaining the retired function.
  // Launch the original executable unchanged; never consult ClawDad accounts.
  if(!binary||!path.isAbsolute(binary)||fs.realpathSync(binary)===fs.realpathSync(process.argv[1]))throw Error('Use the original Codex executable.');
  const child=spawn(binary,args,{stdio:'inherit',env:process.env});
  child.on('error',()=>{console.error('Could not start the original Codex executable.');process.exitCode=1;});
  child.on('exit',(code,signal)=>{if(signal)process.kill(process.pid,signal);else process.exitCode=code??1;});
}catch(error){
  console.error('ClawDad: '+error.message+' No Codex session was started.');
  process.exitCode=1;
}
