#!/usr/bin/env zsh
set -euo pipefail

repo_root=${0:A:h:h}
package_dir="$repo_root/vendor/WebRTCPackage"
archive="$package_dir/WebRTC-M150.xcframework.zip"
framework="$package_dir/WebRTC.xcframework"
download_url="https://github.com/stasel/WebRTC/releases/download/150.0.0/WebRTC-M150.xcframework.zip"
expected_sha256="f9890492b0016e4c88ab20f07867b8b420054caedc8a692b2ec6ac041f3cf6b2"

if [[ -d "$framework" ]]; then
  exit 0
fi

mkdir -p "$package_dir"
curl --fail --location --retry 3 --output "$archive" "$download_url"

actual_sha256=$(shasum -a 256 "$archive" | awk '{print $1}')
if [[ "$actual_sha256" != "$expected_sha256" ]]; then
  printf 'WebRTC archive checksum mismatch: expected %s, got %s\n' \
    "$expected_sha256" "$actual_sha256" >&2
  exit 1
fi

unzip -q -o "$archive" -d "$package_dir"
rm -f "$archive"

if [[ ! -d "$framework" ]]; then
  printf 'WebRTC archive did not contain WebRTC.xcframework\n' >&2
  exit 1
fi
