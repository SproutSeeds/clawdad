#!/bin/zsh
set -euo pipefail

script_dir=${0:A:h}
repo_root=${script_dir:h}
app_root="$repo_root/apps/ios/ClawDadMobile"
project="$app_root/ClawDadMobile.xcodeproj"
scheme="${CLAWDAD_SCREENSHOT_SCHEME:-ClawDadMobile}"
device_name="${CLAWDAD_SCREENSHOT_DEVICE_NAME:-ClawDad App Store 6.9}"
device_type="${CLAWDAD_SCREENSHOT_DEVICE_TYPE:-com.apple.CoreSimulator.SimDeviceType.iPhone-16-Pro-Max}"
runtime="${CLAWDAD_SCREENSHOT_RUNTIME:-com.apple.CoreSimulator.SimRuntime.iOS-26-5}"
derived_data="${CLAWDAD_SCREENSHOT_DERIVED_DATA:-$app_root/build/AppStoreScreenshots}"
output_dir="${CLAWDAD_SCREENSHOT_OUTPUT_DIR:-$repo_root/docs/app-store/screenshots/iphone-6.9}"
bundle_id="earth.frg.clawdad.ios"

device_id=$(
  xcrun simctl list devices available -j |
    jq -r --arg name "$device_name" \
      '[.devices[][] | select(.name == $name)][0].udid // empty'
)

if [[ -z "$device_id" ]]; then
  device_id=$(xcrun simctl create "$device_name" "$device_type" "$runtime")
fi

xcrun simctl boot "$device_id" >/dev/null 2>&1 || true
xcrun simctl bootstatus "$device_id" -b
xcrun simctl ui "$device_id" appearance dark
xcrun simctl status_bar "$device_id" override \
  --time "9:41" \
  --batteryState charged \
  --batteryLevel 100 \
  --wifiBars 3 \
  --cellularMode active \
  --cellularBars 4

xcodebuild \
  -quiet \
  -project "$project" \
  -scheme "$scheme" \
  -configuration Debug \
  -sdk iphonesimulator \
  -destination "platform=iOS Simulator,id=$device_id" \
  -derivedDataPath "$derived_data" \
  CODE_SIGNING_ALLOWED=NO \
  build

app_path="$derived_data/Build/Products/Debug-iphonesimulator/ClawDad.app"
if [[ ! -d "$app_path" ]]; then
  print -u2 "Built ClawDad app was not found: $app_path"
  exit 66
fi

mkdir -p "$output_dir"
xcrun simctl terminate "$device_id" "$bundle_id" >/dev/null 2>&1 || true
xcrun simctl uninstall "$device_id" "$bundle_id" >/dev/null 2>&1 || true
xcrun simctl install "$device_id" "$app_path"

capture_scenario() {
  local scenario=$1
  local destination=$2
  local temporary="/tmp/clawdad-app-store-${scenario}.png"
  xcrun simctl launch --terminate-running-process \
    "$device_id" \
    "$bundle_id" \
    --clawdad-app-store-preview \
    "$scenario" >/dev/null
  sleep 3
  xcrun simctl io "$device_id" screenshot --type=png --mask=black "$temporary"
  cp "$temporary" "$destination"
  rm -f "$temporary"
}

capture_scenario "workspace" "$output_dir/01-workspace.png"
capture_scenario "conversation" "$output_dir/02-conversation.png"

for screenshot in "$output_dir"/*.png; do
  dimensions=$(sips -g pixelWidth -g pixelHeight "$screenshot" |
    awk '/pixelWidth|pixelHeight/ { print $2 }' |
    paste -sd x -)
  if [[ "$dimensions" != "1290x2796" ]]; then
    print -u2 "Unexpected screenshot dimensions for $screenshot: $dimensions"
    exit 65
  fi
  alpha=$(sips -g hasAlpha "$screenshot" |
    awk '/hasAlpha/ { print $2 }')
  if [[ "$alpha" != "no" ]]; then
    print -u2 "App Store screenshot must be opaque: $screenshot"
    exit 65
  fi
done

print "App Store screenshots written to $output_dir"
