<Application
    x:Class="ClawDad.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="ClawDadBackgroundColor">#FF280203</Color>
      <Color x:Key="ClawDadPanelColor">#FF4A080A</Color>
      <Color x:Key="ClawDadGoldColor">#FFFFBF35</Color>
      <SolidColorBrush x:Key="ClawDadBackground" Color="{StaticResource ClawDadBackgroundColor}" />
      <SolidColorBrush x:Key="ClawDadPanel" Color="{StaticResource ClawDadPanelColor}" />
      <SolidColorBrush x:Key="ClawDadGold" Color="{StaticResource ClawDadGoldColor}" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
